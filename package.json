{
  "name": "daily-silver",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first unofficial Gen II-inspired daily battle game with original procedural effects and optional PokéAPI roster expansion",
  "scripts": {
    "start": "node tools/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/ui-smoke.mjs",
    "prebuild": "node tools/audit-sprites.mjs",
    "build": "node tools/build.mjs",
    "expand-roster": "node tools/expand-roster.mjs",
    "art:audit": "node tools/audit-sprites.mjs",
    "browser:install": "playwright install chromium",
    "uat:visual": "node tools/uat.mjs visual",
    "uat:playthrough": "node tools/uat.mjs playthrough",
    "uat:victory": "node tools/uat.mjs victory",
    "uat:offline": "node tools/uat.mjs offline",
    "manifest": "node tools/manifest.mjs",
    "art:generate": "node tools/art-generate.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
